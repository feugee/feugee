# Local Postgres (docker compose up -d) — user/password/db default to "feugee"
POSTGRES_USER=feugee
POSTGRES_PASSWORD=feugee
POSTGRES_DB=feugee
POSTGRES_PORT=5432
DATABASE_URL=postgres://feugee:feugee@localhost:5432/feugee

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Canonical URL of the deployment — Payload builds admin and password-reset
# links from it. Must be https:// in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First admin account, seeded by `npm run seed`
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=change-me
# Demo content (sample Works, testimonials, placeholder contact details).
# Seeded automatically outside production; in production set explicitly to
# "true" (or "1") to seed it — otherwise the seed creates the admin only.
# SEED_DEMO=

# Email transport — sends the CMS password-reset email. Exactly one provider:
# SMTP_* (any SMTP server) or RESEND_API_KEY (transactional service) — the
# Agency's call; see docs/adr/0009. Local dev points SMTP at Mailpit
# (docker compose up -d); read the mail it catches at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=
EMAIL_FROM_ADDRESS=feugee@feugee.test
EMAIL_FROM_NAME=Feugee

# Local dev containers (docker compose up -d)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Asset storage — production uses Cloudflare R2; local dev points the same
# credentials at an S3-compatible cluster instead. Exactly one of
# R2_ACCOUNT_ID (production, endpoint derived) or R2_ENDPOINT (override) is
# required — see docs/adr/0002.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Production: R2_ACCOUNT_ID=
# Local dev example (Biznet Gio Neo): R2_ENDPOINT=https://nos.wjv-1.neo.id
