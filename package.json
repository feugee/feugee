    "@payloadcms/plugin-seo": "3.90.1",
    "@payloadcms/richtext-lexical": "^3.90.1",
    "@payloadcms/storage-s3": "^3.90.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.4",
    "payload": "^3.90.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
